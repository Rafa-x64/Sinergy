# Copia este archivo como .env y rellena los valores para tu entorno.
# IMPORTANTE: Los valores con caracteres especiales (#, @, !, espacios) DEBEN
# ir entre comillas dobles para que dotenv los lea correctamente.
# Ejemplo correcto:   DB_PASSWORD="mi#Pass@word!"
# Ejemplo incorrecto: DB_PASSWORD=mi#Pass@word!   (el # inicia un comentario)

# ─── Base de Datos ────────────────────────────────────────────────────────────
# El sistema construye la DATABASE_URL automáticamente desde las variables
# individuales (DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME) usando
# encodeURIComponent para neutralizar caracteres especiales en la contraseña.
# Si defines DATABASE_URL directamente, esa toma precedencia — en ese caso
# asegúrate de URL-encodear la contraseña manualmente:
#   #  →  %23
#   @  →  %40
#   !  →  %21
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD="postgres"
DB_NAME=sinergy_dev
# DATABASE_URL se construye automáticamente. Descomenta solo si necesitas
# sobreescribir la construcción automática:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sinergy_dev?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANTE: Cambiar por secrets aleatorios largos en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRET_SEGURO_DE_64_BYTES
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRET_SEGURO_DE_64_BYTES

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes del frontend permitidos (separados por coma).
# En desarrollo ya se permiten localhost y LAN (192.168.x, 10.x, 172.16-31.x).
# Agregar aquí la URL exacta donde corre el frontend en producción:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
