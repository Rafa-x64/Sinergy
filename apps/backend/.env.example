# Copia este archivo como .env y rellena los valores para tu entorno.

# ─── Base de Datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/database?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANTE: Cambiar por secrets aleatorios largos en producción.
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRET_SEGURO
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRET_SEGURO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes del frontend permitidos (separados por coma).
# En desarrollo ya se permiten localhost y LAN (192.168.x, 10.x, 172.16-31.x).
# Agregar aquí la URL exacta donde corre el frontend en producción:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
