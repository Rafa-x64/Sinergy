// =============================================================================
// PRISMA SCHEMA DEFINITIVO Y COMPLETO — SISTEMA SINERGY (TUBRICA)
// Engine: PostgreSQL 14+
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS DE DOMINIO Y SISTEMA
// -----------------------------------------------------------------------------

enum EstadoOperativo {
  OPERATIVO
  INOPERATIVO
  EN_MANTENIMIENTO
}

enum TipoEvaluacion {
  NUMERICO_ENTERO
  NUMERICO_DECIMAL
  TEMPERATURA
  SELECCION
}

enum TipoInspeccion {
  VARIABLES_CRITICAS
  MONTACARGAS
  COMPRESOR
  GENERADOR
  CHILLER
}

enum EstadoInspeccion {
  BORRADOR
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum OrigenDatos {
  ONLINE
  OFFLINE_SYNC
}

enum NotificationType {
  ERROR
  WARNING
  ALERT
  SUCCESS
}

enum CategoriaNotificacion {
  INSPECCION_PENDIENTE
  INSPECCION_APROBADA
  INSPECCION_RECHAZADA
  AUDITORIA_SISTEMA
}

// -----------------------------------------------------------------------------
// CAPA 1: SEGURIDAD, AUTENTICACIÓN Y ROLES (RBAC)
// -----------------------------------------------------------------------------

model Usuario {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  nombreUsuario String    @unique @db.VarChar(50)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime? @map("ultimo_acceso")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  plantaId      Int?      @map("planta_id")
  planta        Planta?   @relation(fields: [plantaId], references: [id])
  supervisorId  Int?      @map("supervisor_id")
  supervisor    Usuario?  @relation("JerarquiaSupervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinados  Usuario[] @relation("JerarquiaSupervision")

  inspeccionesElaboradas Inspeccion[]   @relation("ElaboradoPor")
  inspeccionesRevisadas  Inspeccion[]   @relation("RevisadoPor")
  inspeccionesAprobadas  Inspeccion[]   @relation("AprobadoPor")
  logsAuditoria          AuditoriaLog[]
  rolesUsuario           UsuarioRol[]
  notificaciones         Notificacion[]
  lecturasHorometro      HistorialHorometro[]
  rutinasLubricacion     RutinaLubricacion[]

  @@index([supervisorId])
  @@map("usuarios")
}

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.Text

  esSupervisor       Boolean @default(false) @map("es_supervisor")
  requiereSupervisor Boolean @default(false) @map("requiere_supervisor")

  rolesUsuario UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  id        Int @id @default(autoincrement())
  rolId     Int @map("rol_id")
  usuarioId Int @map("usuario_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([rolId, usuarioId], name: "uq_usuario_rol")
  @@map("roles_usuario")
}

// -----------------------------------------------------------------------------
// CAPA 2: INFRAESTRUCTURA Y MAESTROS DE PLANTA (DATA-DRIVEN UI)
// -----------------------------------------------------------------------------

model Planta {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique @db.VarChar(50)
  nombre        String    @unique @db.VarChar(255)
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")
  usuarios      Usuario[]

  ubicacionesTecnicas UbicacionTecnica[]
  inspecciones        Inspeccion[]
  rutinasLubricacion  RutinaLubricacion[]

  @@map("plantas")
}

model UbicacionTecnica {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique @db.VarChar(50)
  nombre        String   @db.VarChar(255)
  descripcion   String?  @db.Text
  plantaId      Int      @map("planta_id")
  planta        Planta   @relation(fields: [plantaId], references: [id], onDelete: Restrict)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  equipos      Equipo[]
  inspecciones Inspeccion[]
  rutinasLubricacion RutinaLubricacion[]

  @@index([plantaId])
  @@map("ubicaciones_tecnicas")
}

model Equipo {
  id              Int             @id @default(autoincrement())
  codigo          String          @unique @db.VarChar(100)
  nombre          String          @db.VarChar(255)
  serial          String?         @db.VarChar(100)
  marca           String?         @db.VarChar(100)
  modelo          String?         @db.VarChar(100)
  estadoOperativo EstadoOperativo @default(OPERATIVO) @map("estado_operativo")
  observacion     String?         @db.Text
  creadoEn        DateTime        @default(now()) @map("creado_en")
  actualizadoEn   DateTime        @updatedAt @map("actualizado_en")

  ubicacionTecnicaId Int @map("ubicacion_tecnica_id")
  tipoEquipoId       Int @map("tipo_equipo_id")

  ubicacionTecnica UbicacionTecnica @relation(fields: [ubicacionTecnicaId], references: [id], onDelete: Restrict)
  tipoEquipo       TipoEquipo       @relation(fields: [tipoEquipoId], references: [id], onDelete: Restrict)

  montacargasDetalle MontacargasDetalle?
  componentes        Componente[]
  inspecciones       Inspeccion[]
  puntosLubricacion   PuntoLubricacion[]
  historialHorometros HistorialHorometro[]
  rutinasLubricacion  RutinaLubricacion[]

  @@index([ubicacionTecnicaId])
  @@index([tipoEquipoId])
  @@index([estadoOperativo])
  @@map("equipos")
}

model TipoEquipo {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.Text

  equipos      Equipo[]
  plantillas   PlantillaVariable[]
  inspecciones Inspeccion[]

  @@map("tipos_equipo")
}

model MontacargasDetalle {
  id                      Int     @id @default(autoincrement())
  equipoId                Int     @unique @map("equipo_id")
  equipo                  Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  denominacion            String  @db.VarChar(255)
  tipoMontacarga          String  @default("Montacarga") @map("tipo_montacarga") @db.VarChar(100)
  marca                   String  @db.VarChar(100)
  modelo                  String  @db.VarChar(100)
  identificacionAbreviada String  @map("identificacion_abreviada") @db.VarChar(50)
  ubicacionTecnicaTexto   String  @map("ubicacion_tecnica_texto") @db.VarChar(100)
  denominacion2           String? @map("denominacion_2") @db.Text

  @@map("montacargas_detalles")
}

model Componente {
  id            Int      @id @default(autoincrement())
  equipoId      Int      @map("equipo_id")
  equipo        Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  nombre        String   @db.VarChar(255)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  ordenPosicion Int      @default(0) @map("orden_posicion")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  variables Variable[]
  puntosLubricacion PuntoLubricacion[]

  @@index([equipoId])
  @@index([activo]) // D-05: filtro frecuente en carga de formulario Data-Driven
  @@map("componentes")
}

model Variable {
  id             Int                @id @default(autoincrement())
  componenteId   Int                @map("componente_id")
  componente     Componente         @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  plantillaId    Int?               @map("plantilla_id") // FK a la plantilla que le dio origen
  plantilla      PlantillaVariable? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  // Los demás campos se copian de la plantilla al crear la instancia
  nombre         String             @db.VarChar(255)
  tipoEvaluacion TipoEvaluacion     @map("tipo_evaluacion")
  unidad         String?            @db.VarChar(20)
  valorMinimo    Decimal?           @map("valor_minimo") @db.Decimal(12, 4)
  valorMaximo    Decimal?           @map("valor_maximo") @db.Decimal(12, 4)
  ordenPosicion  Int                @default(0) @map("orden_posicion")
  activa         Boolean            @default(true)
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")

  opcionesSeleccion  OpcionSeleccion[]
  inspeccionDetalles InspeccionDetalle[]

  @@index([componenteId])
  @@index([plantillaId])
  @@map("variables")
}

model OpcionSeleccion {
  id            Int      @id @default(autoincrement())
  variableId    Int      @map("variable_id")
  variable      Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  clave         String   @db.VarChar(10)
  etiqueta      String   @db.VarChar(100)
  ordenPosicion Int      @default(0) @map("orden_posicion")

  @@unique([variableId, clave], name: "uq_variable_clave")
  @@index([variableId])
  @@map("opciones_seleccion")
}

model PlantillaVariable {
  id               Int             @id @default(autoincrement())
  tipoEquipoId     Int             @map("tipo_equipo_id")
  tipoEquipo       TipoEquipo      @relation(fields: [tipoEquipoId], references: [id], onDelete: Cascade)
  // Opcional: si quieres diferenciar por tipo de inspección
  tipoInspeccion   TipoInspeccion? @map("tipo_inspeccion")
  nombreComponente String?         @map("nombre_componente") @db.VarChar(255)
  nombre           String          @db.VarChar(255)
  descripcion      String?         @db.Text
  tipoEvaluacion   TipoEvaluacion  @map("tipo_evaluacion")
  unidad           String?         @db.VarChar(20)
  valorMinimo      Decimal?        @map("valor_minimo") @db.Decimal(12, 4)
  valorMaximo      Decimal?        @map("valor_maximo") @db.Decimal(12, 4)
  ordenPosicion    Int             @default(0) @map("orden_posicion")
  activa           Boolean         @default(true)
  creadoEn         DateTime        @default(now()) @map("creado_en")
  actualizadoEn    DateTime        @updatedAt @map("actualizado_en")

  opcionesSeleccion  PlantillaOpcionSeleccion[]
  variablesInstancia Variable[]

  @@index([tipoEquipoId])
  @@index([tipoInspeccion])
  @@index([nombreComponente])
  @@map("plantilla_variables")
}

model PlantillaOpcionSeleccion {
  id            Int                @id @default(autoincrement())
  plantillaId   Int?               @map("plantilla_id")
  plantilla     PlantillaVariable? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  clave         String             @db.VarChar(10)
  etiqueta      String             @db.VarChar(100)
  ordenPosicion Int                @default(0) @map("orden_posicion")

  @@unique([plantillaId, clave], name: "uq_plantilla_clave")
  @@index([plantillaId])
  @@map("plantilla_opciones_seleccion")
}

// -----------------------------------------------------------------------------
// CAPA 3: REGISTRO TRANSACCIONAL DE INSPECCIONES
// -----------------------------------------------------------------------------

model Inspeccion {
  // D-03: BIGINT — tabla de alto volumen. Inspecciones diarias pueden superar 2.1M registros.
  id               BigInt         @id @default(autoincrement())
  codigoInspeccion String         @unique @map("codigo_inspeccion") @db.VarChar(100)
  tipoInspeccion   TipoInspeccion @map("tipo_inspeccion")

  plantaId Int?    @map("planta_id")
  planta   Planta? @relation(fields: [plantaId], references: [id], onDelete: SetNull)

  ubicacionTecnicaId Int?              @map("ubicacion_tecnica_id")
  ubicacionTecnica   UbicacionTecnica? @relation(fields: [ubicacionTecnicaId], references: [id], onDelete: SetNull)

  tipoEquipoId Int?        @map("tipo_equipo_id")
  tipoEquipo   TipoEquipo? @relation(fields: [tipoEquipoId], references: [id], onDelete: SetNull)

  equipoId Int?    @map("equipo_id")
  equipo   Equipo? @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  elaboradoPorId         Int              @map("elaborado_por")
  elaboradoPor           Usuario          @relation("ElaboradoPor", fields: [elaboradoPorId], references: [id], onDelete: Restrict)
  revisadoPorId          Int?             @map("revisado_por")
  revisadoPor            Usuario?         @relation("RevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  aprobadoPorId          Int?             @map("aprobado_por")
  aprobadoPor            Usuario?         @relation("AprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  fechaRegistro          DateTime         @default(now()) @map("fecha_registro")
  fechaSincronizacion    DateTime?        @map("fecha_sincronizacion")
  estadoInspeccion       EstadoInspeccion @default(PENDIENTE) @map("estado_inspeccion")
  origenDatos            OrigenDatos      @default(ONLINE) @map("origen_datos")
  observacionesGenerales String?          @map("observaciones_generales") @db.Text
  motivoRechazo          String?          @map("motivo_rechazo") @db.Text
  creadoEn               DateTime         @default(now()) @map("creado_en")
  actualizadoEn          DateTime         @updatedAt @map("actualizado_en")

  detalles InspeccionDetalle[]
  adjuntos InspeccionAdjunto[]

  @@index([plantaId])
  @@index([ubicacionTecnicaId])
  @@index([tipoEquipoId])
  @@index([equipoId])
  @@index([elaboradoPorId])
  @@index([fechaRegistro])
  @@index([estadoInspeccion])
  @@index([tipoInspeccion])
  @@index([origenDatos]) // D-07: Dashboard de sincronización OFFLINE_SYNC pendientes
  @@map("inspecciones")
}

model InspeccionDetalle {
  // D-03: BIGINT — puede tener N filas por inspección, volumen aún mayor que inspecciones.
  id               BigInt     @id @default(autoincrement())
  inspeccionId     BigInt     @map("inspeccion_id") // FK a Inspeccion.id (BigInt)
  inspeccion       Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  variableId       Int        @map("variable_id")
  variable         Variable   @relation(fields: [variableId], references: [id], onDelete: Restrict)
  valorNumerico    Decimal?   @map("valor_numerico") @db.Decimal(12, 4)
  valorSeleccion   String?    @map("valor_seleccion") @db.VarChar(10)
  observaciones    String?    @db.Text
  estadoComponente Boolean    @default(true) @map("estado_componente")

  adjuntos InspeccionAdjunto[]

  @@index([inspeccionId])
  @@index([variableId])
  @@map("inspeccion_detalles")
}

model InspeccionAdjunto {
  // D-03: BIGINT — volumen proporcional a inspeccion_detalles.
  id            BigInt             @id @default(autoincrement())
  inspeccionId  BigInt             @map("inspeccion_id") // FK a Inspeccion.id (BigInt)
  inspeccion    Inspeccion         @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  detalleId     BigInt?            @map("detalle_id") // FK a InspeccionDetalle.id (BigInt)
  detalle       InspeccionDetalle? @relation(fields: [detalleId], references: [id], onDelete: Cascade)
  rutaArchivo   String             @map("ruta_archivo") @db.VarChar(500)
  nombreArchivo String             @map("nombre_archivo") @db.VarChar(255)
  tipoMime      String             @map("tipo_mime") @db.VarChar(100)
  tamanoBytes   BigInt             @map("tamano_bytes")
  creadoEn      DateTime           @default(now()) @map("creado_en")

  @@index([inspeccionId])
  @@index([detalleId]) // D-04: índice para queries por variable específica
  @@map("inspeccion_adjuntos")
}

// -----------------------------------------------------------------------------
// CAPA 4: AUDITORÍA Y TRAZABILIDAD ISO
// -----------------------------------------------------------------------------

model AuditoriaLog {
  // D-03: registro_id como BigInt para cubrir IDs de tablas transaccionales que cambian a BigInt.
  id            BigInt   @id @default(autoincrement())
  usuarioId     Int?     @map("usuario_id")
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion        String   @db.VarChar(100)
  tablaAfectada String   @map("tabla_afectada") @db.VarChar(100)
  registroId    BigInt   @map("registro_id") // D-03: cubre IDs de cualquier tabla, incluidas las BIGINT
  datosPrevios  Json?    @map("datos_previos")
  datosNuevos   Json?    @map("datos_nuevos")
  ipOrigen      String?  @map("ip_origen") @db.VarChar(45)
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@index([tablaAfectada, registroId])
  @@index([creadoEn])
  @@map("auditoria_logs")
}

// -----------------------------------------------------------------------------
// CAPA 5: NOTIFICACIONES POR USUARIO
// -----------------------------------------------------------------------------

model Notificacion {
  id        String                @id @default(uuid())
  usuarioId Int?                  @map("usuario_id")
  usuario   Usuario?              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      NotificationType
  categoria CategoriaNotificacion @default(AUDITORIA_SISTEMA)
  titulo    String                @default("Notificación del Sistema") @db.VarChar(150)
  mensaje   String                @db.Text

  entidadAfectada String? @map("entidad_afectada") @db.VarChar(50)
  entidadId       String? @map("entidad_id") @db.VarChar(100)

  leido    Boolean  @default(false) @map("is_read")
  creadoEn DateTime @default(now()) @map("created_at")

  @@index([usuarioId, leido])
  @@index([categoria])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// CAPA 6: LUBRICACIÓN Y HORÓMETROS
// -----------------------------------------------------------------------------

enum TipoLubricante {
  ACEITE
  GRASA
  OTRO
}

enum NivelLubricante {
  OK
  BAJO
  CRITICO
  SOBRELLENADO
  NO_APLICA
}

enum UnidadMedidaLubricante {
  LITROS
  KILOGRAMOS
  GALONES
}

enum OrigenLecturaHorometro {
  RUTINA_LUBRICACION
  INSPECCION_OPERATIVA
  LECTURA_MANUAL
  CAMBIO_ACEITE
}

model CatalogoLubricante {
  id           Int                    @id @default(autoincrement())
  codigo       String                 @unique @db.VarChar(50)
  nombre       String                 @db.VarChar(150)
  marca        String?                @db.VarChar(100)
  tipo         TipoLubricante
  viscosidad   String?                @db.VarChar(50)
  unidadMedida UnidadMedidaLubricante @default(LITROS) @map("unidad_medida")
  activo       Boolean                @default(true)
  creadoEn     DateTime               @default(now()) @map("creado_en")

  puntosLubricacion PuntoLubricacion[]

  @@map("catalogo_lubricantes")
}

model PuntoLubricacion {
  id                    Int                @id @default(autoincrement())
  equipoId              Int                @map("equipo_id")
  equipo                Equipo             @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  componenteId          Int?               @map("componente_id")
  componente            Componente?        @relation(fields: [componenteId], references: [id], onDelete: SetNull)
  lubricanteId          Int                @map("lubricante_id")
  lubricante            CatalogoLubricante @relation(fields: [lubricanteId], references: [id], onDelete: Restrict)
  nombrePunto           String             @map("nombre_punto") @db.VarChar(150)
  limiteHorasCambio     Decimal            @map("limite_horas_cambio") @db.Decimal(10, 2)
  horometroUltimoCambio Decimal            @default(0) @map("horometro_ultimo_cambio") @db.Decimal(10, 2)
  fechaUltimoCambio     DateTime?          @map("fecha_ultimo_cambio")
  capacidadRecomendada  Decimal?           @map("capacidad_recomendada") @db.Decimal(8, 2)
  activo                Boolean            @default(true)
  creadoEn              DateTime           @default(now()) @map("creado_en")
  actualizadoEn         DateTime           @updatedAt @map("actualizado_en")

  detallesRutina RutinaLubricacionDetalle[]

  @@index([equipoId])
  @@index([componenteId])
  @@index([lubricanteId])
  @@map("puntos_lubricacion")
}

model HistorialHorometro {
  id               BigInt                 @id @default(autoincrement())
  equipoId         Int                    @map("equipo_id")
  equipo           Equipo                 @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  valorHorometro   Decimal                @map("valor_horometro") @db.Decimal(10, 2)
  fechaLectura     DateTime               @default(now()) @map("fecha_lectura")
  origen           OrigenLecturaHorometro @default(RUTINA_LUBRICACION)
  registradoPorId  Int                    @map("registrado_por_id")
  registradoPor    Usuario                @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  esReemplazoReloj Boolean                @default(false) @map("es_reemplazo_reloj")
  justificacion    String?                @db.Text

  @@index([equipoId, fechaLectura])
  @@map("historial_horometros")
}

model RutinaLubricacion {
  id                  BigInt            @id @default(autoincrement())
  codigoRutina        String            @unique @map("codigo_rutina") @db.VarChar(100)
  plantaId            Int               @map("planta_id")
  planta              Planta            @relation(fields: [plantaId], references: [id], onDelete: Restrict)
  ubicacionTecnicaId  Int               @map("ubicacion_tecnica_id")
  ubicacionTecnica    UbicacionTecnica  @relation(fields: [ubicacionTecnicaId], references: [id], onDelete: Restrict)
  equipoId            Int               @map("equipo_id")
  equipo              Equipo            @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  elaboradoPorId      Int               @map("elaborado_por_id")
  elaboradoPor        Usuario           @relation(fields: [elaboradoPorId], references: [id], onDelete: Restrict)
  fechaEjecucion      DateTime          @default(now()) @map("fecha_ejecucion")
  horometroRegistrado Decimal           @map("horometro_registrado") @db.Decimal(10, 2)
  observaciones       String?           @db.Text
  creadoEn            DateTime          @default(now()) @map("creado_en")

  detalles RutinaLubricacionDetalle[]

  @@index([plantaId])
  @@index([ubicacionTecnicaId])
  @@index([equipoId])
  @@index([fechaEjecucion])
  @@map("rutinas_lubricacion")
}

model RutinaLubricacionDetalle {
  id                   BigInt            @id @default(autoincrement())
  rutinaId             BigInt            @map("rutina_id")
  rutina               RutinaLubricacion @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  puntoLubricacionId   Int               @map("punto_lubricacion_id")
  puntoLubricacion     PuntoLubricacion  @relation(fields: [puntoLubricacionId], references: [id], onDelete: Restrict)
  nivelLubricante      NivelLubricante   @default(OK) @map("nivel_lubricante")
  seRealizoReposicion  Boolean           @default(false) @map("se_realizo_reposicion")
  cantidadRepuesta     Decimal?          @map("cantidad_repuesta") @db.Decimal(8, 2)
  seRealizoCambioTotal Boolean           @default(false) @map("se_realizo_cambio_total")
  presentaFuga         Boolean           @default(false) @map("presenta_fuga")
  observaciones        String?           @db.Text

  @@index([rutinaId])
  @@index([puntoLubricacionId])
  @@index([presentaFuga])
  @@map("rutina_lubricacion_detalles")
}
