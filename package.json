{
  "name": "sinergy-workspace",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @sinergy/frontend dev",
    "dev:backend": "pnpm --filter @sinergy/backend dev",
    "dev": "concurrently -c \"bgBlue.bold,bgMagenta.bold\" -n \"FRONTEND,BACKEND\" \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "build:frontend": "pnpm --filter @sinergy/frontend build",
    "build:backend": "pnpm --filter @sinergy/backend build",
    "build": "pnpm build:frontend && pnpm build:backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@fortawesome/fontawesome-common-types",
      "@fortawesome/fontawesome-svg-core",
      "@fortawesome/free-solid-svg-icons",
      "browser-tabs-lock",
      "core-js",
      "esbuild",
      "vue-demi",
      "vue-echarts",
      "@prisma/engines",
      "prisma"
    ]
  }
}
